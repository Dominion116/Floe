# Floe Environment Variables

# Public App URL (used for link previews, robots.txt and the sitemap)
NEXT_PUBLIC_APP_URL="https://floeonsui.vercel.app"

# A monitored contact address, shown publicly. GitHub issues are used if empty.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Sui Network (devnet | testnet | mainnet)
NEXT_PUBLIC_SUI_NETWORK="testnet"
NEXT_PUBLIC_SUI_RPC_URL="https://fullnode.testnet.sui.io:443"

# Floe Move Package ID (configured after deploying move/sources/escrow.move)
NEXT_PUBLIC_FLOE_PACKAGE_ID=""

# Sui zkLogin & Google OAuth 2.0 Client ID
# https://docs.sui.io/guides/developer/cryptography/zklogin
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Enoki / Sponsored Gas Station API Key (Zero gas for recipients)
# https://enoki.mystenlabs.com
NEXT_PUBLIC_ENOKI_API_KEY=""
# Server only. Never prefix this with NEXT_PUBLIC_.
ENOKI_SECRET_KEY=""

# Photo and voice gifts on Walrus (optional). Testnet uses public services. Mainnet has no
# public publisher, so gifts stay off there until both are set. Separate several with commas.
NEXT_PUBLIC_WALRUS_PUBLISHER=""
NEXT_PUBLIC_WALRUS_AGGREGATOR=""

# Live SUI and $LOFI prices (optional, server only). Works without a key; a free
# CoinGecko demo key raises the rate limit on shared hosts such as Vercel.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=""

# The water treasury is fixed in move/sources/escrow.move, so it can't be changed here.
